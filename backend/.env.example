# WIPEG backend settings.
#
# Copy to .env and fill in. NEVER commit .env — it holds the database password,
# the Google service-account key and the WhatsApp token.
#
# Every value below is a placeholder. None of these are real.

# ---------------------------------------------------------------- the basics
NODE_ENV=development
PORT=6008
# The public origin the website is served from, used for CORS and for building
# the private links sent to visitors.
PUBLIC_SITE_ORIGIN=http://localhost:6007

# -------------------------------------------------------------- the database
# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooled (port 6543) connection on serverless hosts.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Needed only for uploading and serving documents from Supabase Storage.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------- sessions
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=
SESSION_HOURS=12

# Signs the private links sent to people who book a call or send an enquiry.
# A different secret from SESSION_SECRET, on purpose.
LINK_TOKEN_SECRET=
LINK_TOKEN_DAYS=30

# ------------------------------------------------- signing in with Google
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:6008/api/auth/google/callback

# Only accounts on this domain can sign in at all. Pinned as `hd=` on the
# Google sign-in URL AND checked again on the verified email when it comes
# back, because the first one is only a hint.
GOOGLE_WORKSPACE_DOMAIN=

# ------------------------------- Google Workspace admin + Calendar + Classroom
# The service account's whole JSON key, on one line. Domain-wide delegation,
# limited to the directory, calendar and classroom scopes and nothing more.
# This key can act as any user in the Workspace: treat it like a master key.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Workspace user the service account impersonates for admin work.
GOOGLE_IMPERSONATED_ADMIN=

# The calendar booked calls are written to.
GOOGLE_CALENDAR_ID=

# ---------------------------------------------------------- call booking
BOOKING_TIMEZONE=Africa/Douala
BOOKING_SLOT_MINUTES=30
BOOKING_OPEN_TIME=08:00
BOOKING_CLOSE_TIME=16:00
# 1=Monday … 7=Sunday
BOOKING_DAYS=1,2,3,4,5,6
BOOKING_DAYS_AHEAD=14
# Refuse bookings starting sooner than this, so nobody books a call for 3
# minutes from now.
BOOKING_MIN_NOTICE_MINUTES=120

# ------------------------------------------------------------- WhatsApp
# Meta WhatsApp Cloud API. The template must be approved by Meta before it
# will send; until then reminders fail and the job logs it.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=wipeg_appointment_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en
# Where a reminder goes when nobody has claimed the call yet.
WHATSAPP_FALLBACK_STAFF_PHONE=

# ------------------------------------------------------- the timed jobs
# A long random string. Jobs refuse to run without it, and refuse to run for a
# request that carries a session cookie.
CRON_SECRET=

# --------------------------------------------------------- public forms
# Cloudflare Turnstile, the "not a robot" check on the enquiry and booking forms.
TURNSTILE_SECRET_KEY=

# Where rate-limit counters are kept. Leave blank in development to use memory.
REDIS_URL=
