# WIPEG backend settings.
#
# Copy to .env and fill in. NEVER commit .env — it holds the database
# password and the Google service-account key.
#
# Every value below is a placeholder except the ones marked REAL.

# ---------------------------------------------------------------- the basics
NODE_ENV=development
PORT=6008
# The origin the website is served from. Used for CORS and for the redirect
# back after signing in.
PUBLIC_SITE_ORIGIN=http://localhost:6007
# In production: https://wipeg.online

# -------------------------------------------------------------- the database
# Supabase → Project Settings → Database → Connection string → URI.
# Use the pooled (port 6543) connection on serverless hosts.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Needed only once documents are uploaded and served from Supabase Storage.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------ sessions
# 32+ random bytes. Generate with:  openssl rand -base64 48
# Changing this signs everybody out, which is the right response to a leak.
SESSION_SECRET=
SESSION_HOURS=12

# --------------------------------------------------------- signing in with Google
# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID
# → Web application. Set the consent screen to Internal.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:6008/api/auth/google/callback

# REAL. Only accounts on this domain can sign in. Pinned as `hd=` on the
# sign-in URL AND re-checked on the verified email, because `hd=` is only a
# hint and anyone can edit a URL.
GOOGLE_WORKSPACE_DOMAIN=wipeg.online

# ------------------------------- Google service account (Calendar + Directory)
# The whole JSON key on one line. Needs domain-wide delegation, limited to
# the two scopes the code actually uses:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/admin.directory.user
# This key can act as any user in the Workspace. Treat it as a master key:
# host secret store only, never in the repository, never in a log.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Workspace admin the service account impersonates. Google refuses the
# directory API to a service account that is not acting as a real person.
GOOGLE_IMPERSONATED_ADMIN=admin@wipeg.online

# The shared calendar booked calls are written to. NOT a staff member's own
# calendar — their private appointments should not decide whether a
# prospective student can book, and this should survive them leaving.
GOOGLE_CALENDAR_ID=

# ----------------------------------------------- creating Workspace accounts
# How a new address is built. {given} and {surname} are lowercased and
# stripped of accents; {matricule} is used as stored. A clash gets a number
# appended rather than being refused.
#
# DECIDE THIS ONCE. Changing it later renames nobody, so the school ends up
# with two naming schemes side by side.
#   {given}.{surname}  ->  fai.arnold@wipeg.online
#   {matricule}        ->  wip24cen001@wipeg.online
WORKSPACE_EMAIL_FORMAT={given}.{surname}

# Organisational units the accounts are filed under. Create them in the
# Admin console first, or Google rejects the request.
WORKSPACE_STUDENT_OU=/Students
WORKSPACE_STAFF_OU=/Staff

# ------------------------------------------------------------- call booking
BOOKING_TIMEZONE=Africa/Douala
BOOKING_SLOT_MINUTES=30
BOOKING_OPEN_TIME=08:00
BOOKING_CLOSE_TIME=16:00
# 1=Monday … 7=Sunday
BOOKING_DAYS=1,2,3,4,5,6
BOOKING_DAYS_AHEAD=14
# Refuse bookings sooner than this, so nobody books a call for 3 minutes away.
BOOKING_MIN_NOTICE_MINUTES=120
# Written as the event location for a campus visit, and shown on the
# confirmation screen.
BOOKING_ONSITE_ADDRESS=WIPEG Garoua Campus, Plateau, behind Collège de l'Espoir, Garoua

# -------------------------------------------------------------- timed jobs
# A long random string. Job endpoints refuse to run without it, and refuse to
# run for a request that also carries a session cookie.
CRON_SECRET=

# ------------------------------------------------------------- public forms
# Cloudflare Turnstile, the "not a robot" check on the booking form.
TURNSTILE_SECRET_KEY=

# Shared rate-limit counters. Blank uses in-process memory, which is correct
# on a single host and under-counts across several.
REDIS_URL=
